#!/bin/sh
set -eu

SELF="$HOME/.local/bin/theme"
ROOT="$HOME/.config/theme"
THEMES="$ROOT/themes"
TEMPLATES="$ROOT/templates"
CURRENT="$ROOT/current"

GHOSTTY_OUT="$HOME/.config/ghostty/theme.conf"
TMUX_OUT="$HOME/.config/tmux/theme.conf"
NVIM_OUT="$HOME/.config/nvim/lua/config/theme.lua"
BATTERY_TMUX="$HOME/.tmux/plugins/tmux-battery/battery.tmux"

usage() {
	cat <<'EOF'
theme -- switch Ghostty + tmux + Neovim to a single theme, live.

  theme                    pick from all themes (arrow keys, live preview)
  theme <family>           pick a flavour within a family, e.g. `theme gruvbox`
  theme <family> <flavour> apply directly, e.g. `theme gruvbox light-hard`
  theme <name>             apply directly, e.g. `theme gruvbox-light-hard`
  theme toggle             flip light <-> dark within the current family
  theme list [<family>]    show every theme with colour swatches, no picker
EOF
}

die() { printf 'theme: %s\n' "$*" >&2; exit 1; }

names() {
	for f in "$THEMES"/*.sh; do
		[ -e "$f" ] || continue
		n=${f##*/}
		printf '%s\n' "${n%.sh}"
	done
}

rows() {
	filter=${1:-}
	names | while read -r n; do
		( . "$THEMES/$n.sh"
		  [ -z "$filter" ] || [ "$FAMILY" = "$filter" ] || exit 0
		  printf '%s\t%s\t%s\t%s\n' "$n" "$FAMILY" "$FLAVOUR" "$APPEARANCE" )
	done
}

families() { rows | awk -F'\t' '{print $2}' | sort -u; }

hex2rgb() {
	h=${1#\#}; m=${h#??}
	R=$((16#${h%????})); G=$((16#${m%??})); B=$((16#${h#????}))
}

swatch() {
	[ "$COLOR" = 1 ] || return 0
	for c in "$@"; do
		hex2rgb "$c"
		printf '\033[38;2;%d;%d;%dm███' "$R" "$G" "$B"
	done
	printf '\033[0m'
}

show_table() {
	filter=${1:-}
	cur=$(cat "$CURRENT" 2>/dev/null || true)
	COLOR=0
	[ -t 1 ] && [ -z "${NO_COLOR:-}" ] && COLOR=1
	[ "${THEME_COLOR:-}" = 1 ] && COLOR=1

	printf 'active: %s\n' "${cur:-(unknown)}"
	lastfam=""; n_shown=0
	for n in $(names); do
		. "$THEMES/$n.sh"
		[ -z "$filter" ] || [ "$FAMILY" = "$filter" ] || continue
		if [ "$FAMILY" != "$lastfam" ]; then
			printf '\n%s\n' "$FAMILY"
			lastfam=$FAMILY
		fi
		if [ "$n" = "$cur" ]; then mark='*'; else mark=' '; fi
		printf '  %s %-25s %-14s %-6s ' "$mark" "$n" "$FLAVOUR" "$APPEARANCE"
		swatch "$TM_BASE" "$TM_TEXT" "$TM_INACTIVE" "$TM_ACCENT" "$TM_ACCENT2" "$TM_LOVE"
		printf '\n'
		n_shown=$((n_shown + 1))
	done
	if [ "$n_shown" -eq 0 ] && [ -n "$filter" ]; then
		printf 'theme: no such family: %s\n\nfamilies: %s\n' \
			"$filter" "$(families | tr '\n' ' ')" >&2
		return 1
	fi
	word=themes; [ "$n_shown" -eq 1 ] && word=theme
	if [ "$COLOR" = 1 ]; then
		printf '\n%d %s.  swatch: bg / text / inactive / current / process / alert\n' "$n_shown" "$word"
	else
		printf '\n%d %s.\n' "$n_shown" "$word"
	fi
}

apply() {
	name=$1
	def="$THEMES/$name.sh"
	[ -r "$def" ] || die "no such theme: $name"

	GHOSTTY_BG=""
	. "$def"

	for v in FAMILY FLAVOUR APPEARANCE GHOSTTY_THEME \
		NVIM_COLORSCHEME NVIM_REPO NVIM_PLUGIN NVIM_OPTS \
		TM_TEXT TM_SUBTLE TM_ACCENT2 TM_INACTIVE TM_ACCENT TM_FOAM TM_LOVE TM_PINE \
		TM_MUTED TM_HL_HIGH TM_HL_MED TM_BASE; do
		eval "val=\${$v:-}"
		[ -n "$val" ] || die "$name.sh does not define $v"
	done
	NVIM_MODULE=${NVIM_MODULE:-}

	if [ "${FAST:-0}" != 1 ] && command -v ghostty >/dev/null 2>&1; then
		ghostty +list-themes 2>/dev/null | sed 's/ ([^)]*)$//' | grep -qxF "$GHOSTTY_THEME" \
			|| die "ghostty has no theme \"$GHOSTTY_THEME\" (from $name.sh) -- see: ghostty +list-themes"
	fi

	trap 'rm -f "$GHOSTTY_OUT.new" "$TMUX_OUT.new" "$NVIM_OUT.new" "$CURRENT.new"' EXIT INT TERM
	emit() {
		cat > "$1.new"
		chmod 644 "$1.new"
		mv -f "$1.new" "$1"
	}

	{
		printf '# GENERATED by ~/.local/bin/theme from %s.sh -- do not edit\n' "$name"
		printf 'theme = %s\n' "$GHOSTTY_THEME"
		[ -z "$GHOSTTY_BG" ] || printf 'background = %s\n' "$GHOSTTY_BG"
	} | emit "$GHOSTTY_OUT"

	{
		printf '# GENERATED by ~/.local/bin/theme from %s.sh -- do not edit\n' "$name"
		sed -e "s|\${TM_TEXT}|$TM_TEXT|g" \
			-e "s|\${TM_SUBTLE}|$TM_SUBTLE|g" \
			-e "s|\${TM_ACCENT2}|$TM_ACCENT2|g" \
			-e "s|\${TM_INACTIVE}|$TM_INACTIVE|g" \
			-e "s|\${TM_ACCENT}|$TM_ACCENT|g" \
			-e "s|\${TM_FOAM}|$TM_FOAM|g" \
			-e "s|\${TM_LOVE}|$TM_LOVE|g" \
			-e "s|\${TM_PINE}|$TM_PINE|g" \
			-e "s|\${TM_MUTED}|$TM_MUTED|g" \
			-e "s|\${TM_HL_HIGH}|$TM_HL_HIGH|g" \
			-e "s|\${TM_HL_MED}|$TM_HL_MED|g" \
			-e "s|\${TM_BASE}|$TM_BASE|g" \
			"$TEMPLATES/tmux.conf.in"
	} > "$TMUX_OUT.new"
	if grep -q '\${TM_' "$TMUX_OUT.new"; then
		die "unsubstituted placeholder in tmux theme: $(grep -o '\${TM_[A-Z_]*}' "$TMUX_OUT.new" | sort -u | tr '\n' ' ')"
	fi
	chmod 644 "$TMUX_OUT.new"; mv -f "$TMUX_OUT.new" "$TMUX_OUT"

	emit "$NVIM_OUT" <<EOF
-- GENERATED by ~/.local/bin/theme from $name.sh -- do not edit
return {
  colorscheme = "$NVIM_COLORSCHEME",
  repo = "$NVIM_REPO",
  plugin = "$NVIM_PLUGIN",
  module = "$NVIM_MODULE",
  background = "$APPEARANCE",
  opts = $NVIM_OPTS,
}
EOF

	printf '%s\n' "$name" | emit "$CURRENT"

	mkdir -p "$ROOT/last"
	printf '%s\n' "$name" > "$ROOT/last/$FAMILY.$APPEARANCE"

	applied=""
	pkill -USR2 -x ghostty 2>/dev/null && applied="$applied ghostty"

	if tmux source-file "$TMUX_OUT" 2>/dev/null; then
		applied="$applied tmux"
		if [ "${FAST:-0}" != 1 ] && [ -x "$BATTERY_TMUX" ]; then
			tmux run-shell "$BATTERY_TMUX" 2>/dev/null
		fi
	fi

	nvim_n=0
	for sock in "${TMPDIR:-/tmp/}"nvim."$(id -un)"/*/nvim.*.0; do
		[ -S "$sock" ] || continue
		nvim --server "$sock" --remote-expr "execute('ThemeReload')" >/dev/null 2>&1 \
			&& nvim_n=$((nvim_n + 1))
	done
	[ "$nvim_n" -eq 0 ] || applied="$applied nvim($nvim_n)"

	APPLIED=$applied
}

report() {
	if [ -n "$APPLIED" ]; then
		printf 'theme: %s -- reloaded:%s\n' "$1" "$APPLIED"
	else
		printf 'theme: %s -- written (nothing running to reload)\n' "$1"
	fi
}

pick() {
	filter=${1:-}
	only=$(rows "$filter" | awk -F'\t' '{n=$1} END{if (NR==1) print n}')
	if [ -n "$only" ]; then
		apply "$only"; report "$only"; return
	fi

	command -v fzf >/dev/null 2>&1 || {
		show_table "$filter"
		die "fzf not installed -- pass a theme name directly"
	}
	if [ ! -t 0 ] || [ ! -t 1 ]; then
		show_table "$filter"
		die "not a terminal -- pass a theme name directly"
	fi

	orig=$(cat "$CURRENT" 2>/dev/null || true)
	hdr="enter=apply   esc=cancel${orig:+ (back to $orig)}"

	sel=$(rows "$filter" \
		| awk -F'\t' '{printf "%-25s %-11s %-14s %s\n", $1, $2, $3, $4}' \
		| fzf --reverse --height=45% --prompt='theme> ' --header="$hdr" \
		      --bind "focus:execute-silent($SELF --apply {1})" \
		| awk '{print $1}') || true

	if [ -z "$sel" ]; then
		[ -n "$orig" ] && apply "$orig"
		printf 'theme: cancelled%s\n' "${orig:+ -- back to $orig}"
		exit 0
	fi
	apply "$sel"
	report "$sel"
}

case "${1:-}" in
	--apply)
		[ $# -eq 2 ] || die "--apply needs a theme name"
		FAST=1
		apply "$2" >/dev/null 2>&1
		exit 0
		;;
	list|--list|-l) show_table "${2:-}" || exit 1; exit 0 ;;
	-h|--help) usage; exit 0 ;;
esac

if [ $# -eq 0 ]; then
	pick
	exit 0
fi

if [ "$1" = "toggle" ]; then
	cur=$(cat "$CURRENT" 2>/dev/null) || die "no active theme to toggle from"
	. "$THEMES/$cur.sh"
	want=dark; [ "$APPEARANCE" = dark ] && want=light
	if [ "$want" = light ]; then
		target="$cur-light"
	else
		target=${cur%-light}
		[ "$target" = "$cur" ] && target=""
	fi
	[ -n "$target" ] && [ -r "$THEMES/$target.sh" ] \
		|| target=$(cat "$ROOT/last/$FAMILY.$want" 2>/dev/null || true)
	[ -n "$target" ] && [ -r "$THEMES/$target.sh" ] \
		|| target=$(rows "$FAMILY" | awk -F'\t' -v w="$want" '$4==w {print $1; exit}')
	[ -n "$target" ] || die "$FAMILY has no $want flavour"
	apply "$target"; report "$target"
	exit 0
fi

if [ $# -eq 2 ]; then
	target="$1-$2"
	[ -r "$THEMES/$target.sh" ] || die "no such theme: $target"
	apply "$target"; report "$target"
	exit 0
fi

[ $# -eq 1 ] || die "usage: theme [<family> [<flavour>]] | <name> | toggle"

if [ -r "$THEMES/$1.sh" ]; then
	apply "$1"; report "$1"
elif families | grep -qxF "$1"; then
	pick "$1"
else
	printf 'theme: no such theme or family: %s\n\n' "$1" >&2
	show_table >&2
	exit 1
fi
