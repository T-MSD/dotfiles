# Font Configuration
font-family = "FiraCode Nerd Font"
font-size = 18
font-feature = calt
font-feature = liga

# Theme is generated by `theme <name>` (~/.local/bin/theme) -- switch with e.g.
# `theme rose-pine`, don't set `theme =` here. A nested config-file is loaded
# AFTER this entire file, so theme.conf wins over anything above it; the leading
# `?` makes a missing file non-fatal.
config-file = ?theme.conf

# Window & Padding
window-decoration = none
macos-window-shadow = false
macos-window-buttons = hidden

window-padding-x = 10
window-padding-y = 10

# Split leftover (non-cell-divisible) space evenly instead of dumping it at the bottom
window-padding-balance = true

# Background
background-opacity = 1
# background-opacity = 0.90
# background-blur = 35

# Keyboard / macOS Specifics
macos-option-as-alt = left

# Pass Ctrl+Tab through to tmux (session cycling) instead of cycling Ghostty tabs.
# macOS swallows Ctrl+Tab unless an app keybind claims it, so send the
# modifyOtherKeys escape sequence for C-Tab / C-S-Tab manually.
keybind = ctrl+tab=text:\x1b[27;5;9~
keybind = ctrl+shift+tab=text:\x1b[27;6;9~
